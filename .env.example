# Copy to .env and fill in. `.env` is git-ignored and loaded at startup;
# real environment variables always win over it. WAIFU_ENV_FILE picks another
# file (WAIFU_ENV_FILE=0 turns loading off).

# --- Google GenAI (Gemini) -------------------------------------------------
# One key serves both features. Get one at https://aistudio.google.com/apikey
# and `pip install -e .[gemini]`. Every call is billed.
GOOGLE_API_KEY=
# Model for both features; any Gemini model name.
WAIFU_GEMINI_MODEL=gemini-2.5-flash
# Search: Gemini + Google Search grounding lists candidate characters.
# Needs a model that supports the Google Search tool.
WAIFU_GEMINI_SEARCH=0
# WAIFU_GEMINI_SEARCH_MODEL=gemini-2.5-flash
# LLM: Gemini rewrites the player's typed text into search queries (instead
# of the OpenAI-compatible server below). A lite model is plenty here.
WAIFU_GEMINI_LLM=0
# WAIFU_GEMINI_LLM_MODEL=gemini-2.5-flash-lite
# Seconds per request.
WAIFU_GEMINI_TIMEOUT=15
# Run Gemini search off the request thread once a round has candidates.
WAIFU_GEMINI_BACKGROUND=1

# --- Query LLM: OpenAI-compatible server (used when WAIFU_GEMINI_LLM=0) ----
WAIFU_QUERY_LLM=0
WAIFU_QUERY_LLM_BASE_URL=http://localhost:8000/v1
WAIFU_QUERY_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# WAIFU_QUERY_LLM_API_KEY=
# OPENAI_API_KEY is only ever sent to https://api.openai.com
# OPENAI_API_KEY=

# --- Laya -------------------------------------------------------------------
WAIFU_FORCE_FALLBACK=0
WAIFU_LAYA_PRELOAD=1
USE_TF=0

# --- Search -----------------------------------------------------------------
WAIFU_ONLINE_SEARCH=1
WAIFU_SEARCH_BACKEND=auto
# Wikipedia/AniList HTTP 429: extra tries, base backoff seconds (doubles
# when Retry-After is absent), and the longest a single wait may stall a turn.
# WAIFU_HTTP_429_RETRIES=2
# WAIFU_HTTP_429_BACKOFF=0.8
# WAIFU_HTTP_429_CAP=8

# --- Nekomimi guess gate ----------------------------------------------------
# 0.80 guesses on one check. A stable leader may guess earlier: posterior
# at least LEADER_POSTERIOR, LEADER_MARGIN ahead of second place, for
# LEADER_STREAK consecutive checks. Still needs two model judgments.
# WAIFU_NEKOMINI_GUESS_CONFIDENCE=0.80
# WAIFU_NEKOMINI_LEADER_POSTERIOR=0.50
# WAIFU_NEKOMINI_LEADER_MARGIN=0.15
# WAIFU_NEKOMINI_LEADER_STREAK=2
